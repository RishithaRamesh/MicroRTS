<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project basedir="." default="export_jar" name="microrts">
    <property environment="env"/>
    <property name="debuglevel" value="source,lines,vars"/>
    <property name="target" value="1.8"/>
    <property name="source" value="1.8"/>
	<property name="junit.output.dir" value="junit"/>
    <property name="factoryfeud.cycles" value="500"/>
    <property name="factoryfeud.visual.delay" value="50"/>
    <property name="factoryfeud.visual.map" value="maps/factory-feud/factory-feud-12x12.xml"/>
    <property name="factoryfeud.visual.strategy" value="adaptive"/>
	    <property name="factoryfeud.ai.strategy" value="adaptive"/>
	    <property name="factoryfeud.ai.map" value="maps/factory-feud/factory-feud-12x12.xml"/>
    <property name="factoryfeud.experiment.matches" value="20"/>
    <property name="factoryfeud.experiment.map" value="maps/factory-feud/factory-feud-12x12.xml"/>
    <property name="factoryfeud.experiment.seed" value="584"/>
    <property name="factoryfeud.experiment.csv" value="results/factory-feud-experiments.csv"/>
    <property name="factoryfeud.experiment.strategy" value="adaptive"/>
    <property name="factoryfeud.evaluate.cycles" value="500"/>
    <property name="factoryfeud.evaluate.seed" value="584"/>
	    <property name="factoryfeud.evaluate.output.dir" value="results"/>
	    <property name="factoryfeud.pcg.maps.per.family" value="40"/>
	    <property name="factoryfeud.pcg.width" value="16"/>
	    <property name="factoryfeud.pcg.height" value="12"/>
	    <property name="factoryfeud.pcg.base.seed" value="584000"/>
	    <property name="factoryfeud.pcg.max.attempts" value="100"/>
	    <property name="factoryfeud.pcg.map.dir" value="maps/factory-feud/generated"/>
	    <property name="factoryfeud.pcg.analysis.dir" value="results/factory-feud-d2"/>
    <path id="microrts.classpath">
        <pathelement location="bin"/>
        <pathelement location="lib/bots/Coac.jar"/>
        <pathelement location="lib/bots/Droplet.jar"/>
        <pathelement location="lib/bots/GRojoA3N.jar"/>
        <pathelement location="lib/bots/Izanagi.jar"/>
        <pathelement location="lib/bots/mayariBot.jar"/>
        <pathelement location="lib/bots/MixedBot.jar"/>
        <pathelement location="lib/bots/TiamatBot.jar"/>
        <pathelement location="lib/jdom.jar"/>
        <pathelement location="lib/minimal-json-0.9.4.jar"/>
        <pathelement location="lib/weka.jar"/>
    	<pathelement location="lib/hamcrest-all-1.3.jar"/>
        <pathelement location="lib/junit-4.12.jar"/>
    </path>
    <target name="init">
        <mkdir dir="bin"/>
        <copy includeemptydirs="false" todir="bin">
            <fileset dir="src">
                <exclude name="**/*.java"/>
            </fileset>
        </copy>
    </target>
    <target name="clean">
        <delete dir="bin"/>
    </target>
    <target depends="clean" name="cleanall"/>
    <target depends="build-project" name="build"/>
    <target depends="init" name="build-project">
        <echo message="${ant.project.name}: ${ant.file}"/>
        <javac debug="true" debuglevel="${debuglevel}" destdir="bin" includeantruntime="false" source="${source}" target="${target}">
            <src path="src"/>
        	<src path="test"/>
            <classpath refid="microrts.classpath"/>
        </javac>
    </target>
	<target name="test" depends="build">
		<mkdir dir="${junit.output.dir}"/>
		<junit fork="yes" haltonfailure="yes" filtertrace="off" maxmemory="4096m">
			<formatter type="plain" usefile="false"/>
			<test name="microrts.TestLoadingMaps" todir="${junit.output.dir}"/>
			<test name="microrts.TestTracesIntegrity" todir="${junit.output.dir}"/>
			<test name="microrts.TestPathfinding" todir="${junit.output.dir}"/>
			<test name="courseproject.FactoryFeudTest" todir="${junit.output.dir}"/>
			<test name="courseproject.factoryfeud.FactoryFeudControlledExperimentRunnerTest" todir="${junit.output.dir}"/>
			<test name="courseproject.FactoryFeudAITest" todir="${junit.output.dir}"/>
			<test name="courseproject.AdaptiveRoleAITest" todir="${junit.output.dir}"/>
			<test name="courseproject.FactoryFeudExperimentTest" todir="${junit.output.dir}"/>
			<test name="courseproject.FactoryFeudScenarioVariationTest" todir="${junit.output.dir}"/>
			<test name="courseproject.FactoryFeudTelemetryTest" todir="${junit.output.dir}"/>
			<test name="courseproject.factoryfeud.generation.FactoryFeudMapGeneratorTest" todir="${junit.output.dir}"/>
			<test name="courseproject.factoryfeud.generation.FactoryFeudBatchGeneratorTest" todir="${junit.output.dir}"/>
		    <jvmarg line="-ea -XX:ErrorFile=./hs_err.log -XX:ReplayDataFile=./replay.log"/>
		    <classpath refid="microrts.classpath"/>
		</junit>
	</target>
	<target name="factory-feud-smoke" depends="build" description="Run one headless Factory Feud smoke match">
		<java classname="courseproject.factoryfeud.FactoryFeudSmoke" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="${factoryfeud.cycles}"/>
		</java>
	</target>
	<target name="factory-feud-visual" depends="build" description="Visualize P0 FixedRoleAI versus P1 AdaptiveRoleAI">
		<java classname="courseproject.factoryfeud.FactoryFeudVisual" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="${factoryfeud.cycles}"/>
			<arg value="${factoryfeud.visual.delay}"/>
			<arg value="${factoryfeud.visual.map}"/>
			<arg value="${factoryfeud.visual.strategy}"/>
		</java>
	</target>
	<target name="factory-feud-visual-placeholder" depends="build" description="Visualize the legacy placeholder WorkerRush matchup">
		<java classname="courseproject.factoryfeud.FactoryFeudVisual" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="${factoryfeud.cycles}"/>
			<arg value="${factoryfeud.visual.delay}"/>
			<arg value="${factoryfeud.visual.map}"/>
			<arg value="placeholder"/>
		</java>
	</target>
	<target name="factory-feud-ai-smoke" depends="build" description="Run P0 FixedRoleAI versus P1 AdaptiveRoleAI headlessly">
		<java classname="courseproject.factoryfeud.FactoryFeudPhase2Match" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="${factoryfeud.cycles}"/>
			<arg value="${factoryfeud.ai.strategy}"/>
			<arg value="${factoryfeud.ai.map}"/>
		</java>
	</target>
	<target name="factory-feud-phase2" depends="factory-feud-ai-smoke" description="Legacy alias for factory-feud-ai-smoke"/>
	<target name="factory-feud-experiments" depends="build" description="Run paired AdaptiveRoleAI versus FixedRoleAI experiments">
		<java classname="courseproject.factoryfeud.FactoryFeudExperimentRunner" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="--matches"/>
			<arg value="${factoryfeud.experiment.matches}"/>
			<arg value="--cycles"/>
			<arg value="${factoryfeud.cycles}"/>
			<arg value="--map"/>
			<arg value="${factoryfeud.experiment.map}"/>
			<arg value="--seed"/>
			<arg value="${factoryfeud.experiment.seed}"/>
			<arg value="--csv"/>
			<arg value="${factoryfeud.experiment.csv}"/>
			<arg value="--adaptive-strategy"/>
			<arg value="${factoryfeud.experiment.strategy}"/>
		</java>
	</target>
	<target name="factory-feud-evaluate" depends="build" description="Discover and evaluate all Factory Feud maps with paired sides">
		<java classname="courseproject.factoryfeud.FactoryFeudControlledExperimentRunner" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="--cycles"/>
			<arg value="${factoryfeud.evaluate.cycles}"/>
			<arg value="--seed"/>
			<arg value="${factoryfeud.evaluate.seed}"/>
			<arg value="--output-dir"/>
			<arg value="${factoryfeud.evaluate.output.dir}"/>
		</java>
	</target>
	<target name="factory-feud-controlled-experiment" depends="factory-feud-evaluate" description="Legacy alias for factory-feud-evaluate"/>
	<target name="factory-feud-generate" depends="build" description="Generate and audit the reproducible D2 map batch">
		<java classname="courseproject.factoryfeud.generation.FactoryFeudBatchGenerator" fork="true" failonerror="true">
			<classpath refid="microrts.classpath"/>
			<arg value="--maps-per-family"/>
			<arg value="${factoryfeud.pcg.maps.per.family}"/>
			<arg value="--width"/>
			<arg value="${factoryfeud.pcg.width}"/>
			<arg value="--height"/>
			<arg value="${factoryfeud.pcg.height}"/>
			<arg value="--base-seed"/>
			<arg value="${factoryfeud.pcg.base.seed}"/>
			<arg value="--max-attempts"/>
			<arg value="${factoryfeud.pcg.max.attempts}"/>
			<arg value="--map-dir"/>
			<arg value="${factoryfeud.pcg.map.dir}"/>
			<arg value="--analysis-dir"/>
			<arg value="${factoryfeud.pcg.analysis.dir}"/>
		</java>
	</target>
	<target name="factory-feud-plot" description="Plot D2 generated-map property distributions">
		<exec executable="python3" failonerror="true">
			<arg value="scripts/factory_feud_d2_plot.py"/>
			<arg value="--input"/>
			<arg value="${factoryfeud.pcg.analysis.dir}/factory-feud-generated-maps.csv"/>
			<arg value="--output-dir"/>
			<arg value="${factoryfeud.pcg.analysis.dir}/plots"/>
		</exec>
	</target>
	<target name="factory-feud-generation-tests" depends="build" description="Run project PCG tests independently of upstream trace fixtures">
		<mkdir dir="${junit.output.dir}"/>
		<junit fork="yes" haltonfailure="yes" filtertrace="off" maxmemory="4096m">
			<formatter type="plain" usefile="false"/>
			<test name="courseproject.factoryfeud.generation.FactoryFeudMapGeneratorTest" todir="${junit.output.dir}"/>
			<test name="courseproject.factoryfeud.generation.FactoryFeudBatchGeneratorTest" todir="${junit.output.dir}"/>
			<jvmarg line="-ea -XX:ErrorFile=./hs_err.log -XX:ReplayDataFile=./replay.log"/>
			<classpath refid="microrts.classpath"/>
		</junit>
	</target>
	<target name="export_jar" depends="cleanall,build-project">
		<mkdir dir="build" />
		<jar destfile="build/microrts.jar" basedir="bin" duplicate="preserve">
			<zipgroupfileset dir="./lib/" includes="**/*.jar" />
			<manifest>
				<attribute name="Main-Class" value="gui.frontend.FrontEnd" />
			</manifest>
		</jar>
	</target>
</project>
